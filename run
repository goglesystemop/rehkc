#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
case "$(uname -m)" in x86_64|amd64) ;; *) echo 'REHKC: this release requires x86_64 Linux.' >&2; exit 1;; esac
unset PYTHONHOME PYTHONPATH
export PYTHONNOUSERSITE=1
exec "$root/runtime/python/bin/python3" -I -B "$root/app/rehkc_boot.py" "$@"
